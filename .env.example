# ============================================================
# solomon 配置模板 —— 复制为 .env 后按需修改
#   cp .env.example .env
# 所有配置都是可选的：不设则用代码默认值（见 src/solomon/config.py）
# ============================================================

# ── LLM / 视觉端点（OpenAI 兼容）─────────────────────────────
# 【推荐】配你的云端端点（任意 OpenAI 兼容 /v1 服务，需支持 chat/completions）：
# LLM_BASE_URL=https://token.sensenova.cn/v1
# LLM_API_KEY=你的密钥
# 模型名（默认 sensenova-6.8-flash-lite，可换端点上任意可用模型）：
# SENSENOVA_MODEL=sensenova-6.8-flash-lite
#
# 【默认回落】不配 LLM_BASE_URL 时，连本地轮换代理 127.0.0.1:3456（备 3458），
# 认证固定 Bearer proxy——仅自建本地代理的用户使用。
#
# 识图：默认走端点原生视觉（图片 base64 → image_url，零额外依赖）。
# 若你的端点不支持 base64 形态（只收公网图片 URL / 报 image 相关错误），
# 设 FAST_VISION_JS 指向仓库 scripts/fast-vision.js 切换到「图床上传→URL」备选线路：
# FAST_VISION_JS=/path/to/solomon/scripts/fast-vision.js
# 端点对未知字段报错时（非 SenseNova 系端点）：
# LLM_OMIT_THINKING=1

# ── 知识库（vault）──────────────────────────────────────────
# 知识库根目录。默认 ~/.solomon/vault（先用 `solomon init` 初始化）。
# 也可以指向你自己的 Obsidian 库（任意路径）。
# SOLOMON_VAULT=/mnt/d/my_obsidian_vault

# 视频中间产物根目录（下载/转写/关键帧等）。默认 ~/.solomon/work。
# WORK_ROOT=/mnt/d/video_notes

# ── 出网代理（可选）─────────────────────────────────────────
# YouTube 等海外视频源需要；B站/国内站全程直连，不配也能用。
# HTTP_PROXY=http://127.0.0.1:7890

# ── 运行时 ─────────────────────────────────────────────────
# 子进程 python 解释器。默认跟随当前解释器（最稳，一般不用动）。
# PYTHON_BIN=python3.13
# 子进程 PYTHONPATH（只有依赖装在系统 dist-packages 时才需要）。
# SOLOMON_PYTHONPATH=/usr/lib/python3/dist-packages

# 字幕降级转写模型（默认 medium）。
# WHISPER_MODEL=medium

# 合集处理上限（默认 5，防合集视频一次跑全部）。
# SOLOMON_MAX_PARTS=5
