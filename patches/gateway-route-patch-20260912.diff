+    # ------------------------------------------------------------------
+    # 确定性 @/@@ profile 路由（不经过 coordinator LLM，解决 SOUL 提示词路由不稳）
+    # ------------------------------------------------------------------
+    _PROFILE_ROUTE_STATE = "__HERMES_HOME__/gateway_default_profiles.json"
+    _HERMES_BIN = "__HERMES_BIN__"
+    # newsolomon 不在确定性路由白名单：入库消息必须走 coordinator SOUL 规则1c
+    # （ingest_with_progress.sh + 进度推送）。若经 chat -Q -q 短路到 newsolomon agent，
+    # agent 会裸推理 10min-2h 远超 _run_profile_query 的 300s 超时 → 用户只收到
+    # 「⏱️ newsolomon 回答超时」25 字短消息（2026-09-10 事故，见 infra/HANDOFF-接续）。
+    _ROUTABLE_PROFILES = frozenset({"solomon", "writer", "researcher", "publisher"})
+
+    @staticmethod
+    def _route_state_key(source: "SessionSource") -> str:
+        return f"{source.platform.value}:{source.chat_id}"
+
+    def _route_state_load(self) -> Dict[str, Dict[str, Any]]:
+        """读取路由状态。旧格式 {key: "profile"} 迁移为 {key: {"profile":..,"sid":None}}。"""
+        data: Dict[str, Any] = {}
+        try:
+            with open(self._PROFILE_ROUTE_STATE, "r", encoding="utf-8") as f:
+                raw = json.load(f)
+            if isinstance(raw, dict):
+                data = raw
+        except (OSError, json.JSONDecodeError):
+            pass
+        for key, val in list(data.items()):
+            if isinstance(val, str):
+                data[key] = {"profile": val, "sid": None}
+            elif not isinstance(val, dict):
+                data.pop(key, None)
+        return data
+
+    def _route_state_save(self, state: Dict[str, Any]) -> None:
+        try:
+            tmp = self._PROFILE_ROUTE_STATE + ".tmp"
+            with open(tmp, "w", encoding="utf-8") as f:
+                json.dump(state, f, ensure_ascii=False)
+            os.replace(tmp, self._PROFILE_ROUTE_STATE)
+        except OSError:
+            logger.warning("Failed to save profile-route state", exc_info=True)
+
+    async def _run_profile_query(
+        self, profile: str, content: str, session_id: Optional[str] = None
+    ) -> "tuple[str, Optional[str]]":
+        """Run `hermes -p <profile> chat -Q -q "<content>" [--resume <session_id>]`。
+        返回 (answer, new_session_id)。-Q 让 stdout 只留最终回答，stderr 带 session_id。"""
+        cmd = [self._HERMES_BIN, "-p", profile, "chat", "-Q", "-q", content]
+        if session_id:
+            cmd += ["--resume", session_id]
+        try:
+            proc = await asyncio.create_subprocess_exec(
+                *cmd,
+                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
+            )
+            stdout, stderr = await asyncio.wait_for(proc.communicate(), timeout=300)
+            answer = stdout.decode("utf-8", errors="replace").strip()
+            err = stderr.decode("utf-8", errors="replace")
+            m = re.search(r"session_id:\s*([0-9a-f_]+)", err)
+            new_sid = m.group(1) if m else session_id
+            return (answer or f"（{profile} 无输出）"), new_sid
+        except asyncio.TimeoutError:
+            return f"⏱️ {profile} 回答超时（>300s）", session_id
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("Deterministic route to %s failed: %s", profile, exc)
+            return f"⚠️ 路由到 {profile} 失败：{exc}", session_id
+
+    async def _hm_deterministic_profile_route(
+        self, event: "MessageEvent", source: "SessionSource"
+    ) -> Optional[str]:
+        """确定性 @@/@ 路由。命中则返回要回给用户的文本，否则 None（走正常 coordinator turn）。"""
+        text = (getattr(event, "text", None) or "").strip()
+        if not text or text.startswith("/"):
+            return None
+        state = self._route_state_load()
+        key = self._route_state_key(source)
+
+        # @@<profile> = 设默认（重置会话）；@@（不带名）= 清默认
+        if text.startswith("@@"):
+            target = text[2:].strip()
+            if target:
+                prof = target.split()[0]
+                if prof in self._ROUTABLE_PROFILES:
+                    state[key] = {"profile": prof, "sid": None}
+                    self._route_state_save(state)
+                    return f"已切到 {prof}，之后直接发消息即可"
+                return None  # 未知 profile → 交回 coordinator
+            state.pop(key, None)
+            self._route_state_save(state)
+            return "已取消默认 profile，回到 coordinator"
+
+        # 解析要路由的 profile + 内容
+        if text.startswith("@"):
+            parts = text[1:].split(None, 1)
+            prof = parts[0] if parts else ""
+            content = parts[1].strip() if len(parts) > 1 else ""
+            if not (prof in self._ROUTABLE_PROFILES and content):
+                return None  # 未知 profile 或空内容 → 交回 coordinator
+        else:
+            entry = state.get(key)
+            prof = (entry.get("profile") or "") if isinstance(entry, dict) else ""
+            content = text
+            # newsolomon 已被移出 _ROUTABLE_PROFILES（入库走 coordinator 规则1c）；
+            # 历史 state 里可能残留 newsolomon 默认，命中时同样交回 coordinator。
+            if not prof or prof not in self._ROUTABLE_PROFILES:
+                return None
+
+        # 会话续接：仅当已存 profile 与本次一致时复用 sid，否则开新会话
+        entry = state.get(key)
+        sid = entry.get("sid") if (isinstance(entry, dict) and entry.get("profile") == prof) else None
+        answer, new_sid = await self._run_profile_query(prof, content, sid)
+        state[key] = {"profile": prof, "sid": new_sid}
+        self._route_state_save(state)
+        return answer
+
