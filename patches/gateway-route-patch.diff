+    async def _notify_result(self, target: str, body: str) -> None:
+        """hermes send 推回原渠道（fire-and-forget，失败记日志）。"""
+        if not target:
+            logger.warning("notify result has no target; dropped")
+            return
+        try:
+            proc = await asyncio.create_subprocess_exec(
+                self._HERMES_BIN, "send", "--to", target,
+                stdin=asyncio.subprocess.PIPE,
+                stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL,
+            )
+            await asyncio.wait_for(proc.communicate(body.encode("utf-8")), timeout=60)
+            logger.info("Result delivered to %s (%d chars)", target, len(body))
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("notify to %s failed: %s", target, exc)
