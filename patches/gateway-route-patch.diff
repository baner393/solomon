+    def _tmp_video_names(self) -> list:
+        """临时学习区的视频目录名（排除 concepts/.kb/隐藏项）。"""
+        if not os.path.isdir(self._TMP_ROOT):
+            return []
+        return sorted(
+            n for n in os.listdir(self._TMP_ROOT)
+            if os.path.isdir(os.path.join(self._TMP_ROOT, n))
+            and not n.startswith(".") and n not in ("concepts",)
+        )
