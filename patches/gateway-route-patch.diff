+        返回 None=已启动；返回错误串=启动失败。"""
+        platform = getattr(source, "platform", None)
+        pv = platform.value if platform else ""
+        chat_id = getattr(source, "chat_id", None) or ""
+        if pv == "qqbot":
+            target = f"qqbot:{chat_id}"
+        elif pv == "feishu":
+            target = f"feishu:{chat_id}"
+        else:
+            target = f"{pv}:{chat_id}" if pv and chat_id else ""
+        cmd = ["bash", self._INGEST_PROGRESS,
+               target or "qqbot:FAEDEE34F6F18627B382D60675233CFD", *extra]
+        env = dict(os.environ)
+        env.setdefault("SOLOMON_VAULT", "/mnt/d/all/ai_agent_about/solomon")
+        env.setdefault("WORK_ROOT", "/mnt/d/ObsidianSpace/VideoNotes")
+        env.setdefault("http_proxy", "http://127.0.0.1:7890")
+        env.setdefault("https_proxy", "http://127.0.0.1:7890")
+        env.setdefault("PYTHONPATH",
+                       "/home/baner/.local/lib/python3.14/site-packages:/usr/lib/python3/dist-packages")
+        try:
+            proc = await asyncio.create_subprocess_exec(
+                *cmd, stdout=asyncio.subprocess.DEVNULL,
+                stderr=asyncio.subprocess.DEVNULL,
+                start_new_session=True,  # detached：网关重启/会话结束不杀
+                env=env,
+            )
+            logger.info("Deterministic progress job pid=%s target=%s extra=%s",
+                        proc.pid, target, extra[:80])
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("Deterministic progress job failed: %s", exc)
+            return f"⚠️ 启动失败：{exc}"
+        return None
