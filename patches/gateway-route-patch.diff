+    async def _hm_deterministic_promote(
+        self, event: "MessageEvent", source: "SessionSource"
+    ) -> Optional[str]:
+        """确定性转正：@newsolomon 转正 <标题> → 临时学习区内容 → 正式入库
+        （ingest.py --from-notes，后台 + watcher 进度）。"""
+        text = _strip_feishu_mention((getattr(event, "text", None) or "").strip())
+        if not text or text.startswith("/"):
+            return None
+        m = self._PROMOTE_RE.match(text)
+        if not m:
+            return None
+        title = m.group(1).strip().strip("，。；;,")
+        found = self._resolve_temp_video(title)
+        if not found:
+            names = self._tmp_video_names()
+            hint = "、".join(names[:8]) if names else "（临时区为空）"
+            return (
