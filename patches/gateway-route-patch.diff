+                                   "retrying SAME session to preserve context", profile, session_id)
+                    answer, new_sid = await _chat_once(session_id, 300)
+                if not answer:
+                    logger.warning("Profile %s resume %s returned empty output; retrying with fresh session",
+                                   profile, session_id)
+                    answer, new_sid = await _chat_once(None, 300)
+            if answer:
+                return answer, new_sid
+            return f"（{profile} 无输出——已重置会话，请重发一次）", None
+        except asyncio.TimeoutError:
+            # chat 超时（长会话上下文重算 / 上游挂流）→ 无历史 oneshot 兜底
+            logger.warning("Profile %s chat timed out; falling back to fresh oneshot", profile)
+            try:
+                fb = await self._oneshot_fresh(profile, content)
+                if fb:
+                    # fresh 兜底成功但 oneshot 无会话——**保留旧 sid**：上下文链不断，
+                    # 下一条消息继续 resume 原会话（fresh 那轮内容不进原会话，可接受；
+                    # 旧逻辑写 None 导致每次超时兜底都静默断链，2026-10-03 复盘）
