+    async def _run_delete_and_notify(self, targets: list, target: str) -> None:
+        """后台执行笔记删除并推送结果。"""
+        try:
+            out = await self._run_delete_script(targets, dry_run=False)
+            body = f"🗑 删除结果：\n\n{out}"
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("delete_and_notify execute failed: %s", exc)
+            body = f"⚠️ 删除执行失败：{exc}"
+        await self._notify_result(target, body)
