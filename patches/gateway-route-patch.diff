+    def _resolve_temp_video(self, title: str):
+        """在临时学习区定位视频：TEMP_ROOT/<标题>/ 目录 + 其 _notes.md。
+
+        返回 (video_title, notes_path, workdir) 或 None。匹配：精确 → 包含（最长优先）。
+        """
+        if not os.path.isdir(self._TMP_ROOT):
+            return None
+        names = self._tmp_video_names()
+        hit = None
+        if title in names:
+            hit = title
+        else:
+            subs = [n for n in names if title in n or n in title]
+            if subs:
+                hit = max(subs, key=len)
+        if not hit:
+            return None
+        workdir = os.path.join(self._TMP_ROOT, hit)
+        notes = os.path.join(workdir, f"{hit}_notes.md")
+        if not os.path.exists(notes):
+            for f in os.listdir(workdir):
+                if f.endswith("_notes.md"):
+                    notes = os.path.join(workdir, f)
+                    break
+        if not os.path.exists(notes):
+            return None
+        return hit, notes, workdir
