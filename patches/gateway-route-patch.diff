+    async def _hm_deterministic_peek(
+        self, event: "MessageEvent", source: "SessionSource"
+    ) -> Optional[str]:
+        """确定性临时读取：@newsolomon 临时读取 <url|--name 标题> [标题：xxx] [--fast] →
+        后台跑 ingest.py --peek（watcher 推进度）。产物落临时学习区，不入库，可随后转正。"""
+        text = _strip_feishu_mention((getattr(event, "text", None) or "").strip())
+        if not text or text.startswith("/"):
+            return None
+        m = self._PEEK_RE.match(text)
+        if not m:
+            return None
+        body, title_arg = self._parse_ingest_input(m.group(1).strip())
+        body, flag_args = self._parse_ingest_flags(body)  # --fast/--images/--name 等
+        if not body and not flag_args:
+            return "📌 请输入要临时读取的视频（URL 或 --name 标题）"
+        extra = ["--peek", *flag_args]
+        if body:
+            extra.append(body)
+        if title_arg:
+            extra.extend(title_arg.split(" ", 1))
+        err = await self._spawn_progress_job(source, extra)
+        if err:
+            return err
+        return (
+            f"📌 开始临时读取：{body}\n"
+            f"（不入库，处理到笔记放临时学习区；完成后可 @solomon 追问，"
+            f"或回复「转正 <标题>」正式入库）"
+        )
