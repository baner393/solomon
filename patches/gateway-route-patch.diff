+    async def _oneshot_fresh(self, profile: str, content: str, timeout_s: float = 240) -> str:
+        """无历史 oneshot（-z）兜底：fresh 会话没有上下文包袱，绝大多数 40-90s 出答案。"""
+        cmd = [self._HERMES_BIN, "-p", profile, "-z", content]
+        proc = await asyncio.create_subprocess_exec(
+            *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
+        )
+        try:
+            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout_s)
+        except asyncio.TimeoutError:
+            try:
+                proc.kill()
+            except Exception:  # noqa: BLE001
+                pass
+            return ""
+        return stdout.decode("utf-8", errors="replace").strip()
+
+    async def _hm_deterministic_profile_route(
+        self, event: "MessageEvent", source: "SessionSource"
+    ) -> Optional[str]:
+        """确定性 @@/@ 路由。命中则返回要回给用户的文本，否则 None（走正常 coordinator turn）。"""
+        text = _strip_feishu_mention((getattr(event, "text", None) or "").strip())
+        if not text or text.startswith("/"):
+            return None
+        state = self._route_state_load()
+        key = self._route_state_key(source)
+
+        # @@<profile> = 设默认（重置会话）；@@（不带名）= 清默认
+        if text.startswith("@@"):
+            target = text[2:].strip()
+            if target:
+                prof = target.split()[0]
+                if prof in self._ROUTABLE_PROFILES:
+                    state[key] = {"profile": prof, "sid": None}
+                    self._route_state_save(state)
+                    return f"已切到 {prof}，之后直接发消息即可"
+                return None  # 未知 profile → 交回 coordinator
+            state.pop(key, None)
+            self._route_state_save(state)
+            return "已取消默认 profile，回到 coordinator"
+
+        # 解析要路由的 profile + 内容
+        if text.startswith("@"):
+            parts = text[1:].split(None, 1)
+            prof = parts[0] if parts else ""
+            content = parts[1].strip() if len(parts) > 1 else ""
+            if not (prof in self._ROUTABLE_PROFILES and content):
+                return None  # 未知 profile 或空内容 → 交回 coordinator
+        else:
+            entry = state.get(key)
+            prof = (entry.get("profile") or "") if isinstance(entry, dict) else ""
+            content = text
+            # newsolomon 已被移出 _ROUTABLE_PROFILES（入库走 coordinator 规则1c）；
+            # 历史 state 里可能残留 newsolomon 默认，命中时同样交回 coordinator。
+            if not prof or prof not in self._ROUTABLE_PROFILES:
+                return None
+
+        # 会话续接：仅当已存 profile 与本次一致时复用 sid，否则开新会话。
+        # sid 永久续接（2026-09-28 用户拍板）：上下文增长由 hermes 原生压缩接管
+        # （窗口 ~256k，阈值 ~50% 才触发摘要化，日常无感）；探测证实 233k token
+        # prefill 仅 32s，上下文大小不是响应瓶颈——真正的超时源是上游抖动，
+        # 由空输出自愈 + 超时 kill + -z fresh 兜底吸收。
+        entry = state.get(key)
+        sid = entry.get("sid") if (isinstance(entry, dict) and entry.get("profile") == prof) else None
+        answer, new_sid = await self._run_profile_query(prof, content, sid)
+        state[key] = {"profile": prof, "sid": new_sid}
+        self._route_state_save(state)
+        return answer
