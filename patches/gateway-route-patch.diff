+                        except OSError:
+                            alive = False
+                    if not alive:
+                        dead_found = True
+                if dead_found:
+                    conn.execute(
+                        "DELETE FROM session_turn_leases WHERE conversation_id=?",
+                        (session_id,))
+                    conn.commit()
+                    logger.warning("Cleared dead turn-lease for %s session %s "
