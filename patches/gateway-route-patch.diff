+    async def _run_profile_query(
+        self, profile: str, content: str, session_id: Optional[str] = None
+    ) -> "tuple[str, Optional[str]]":
+        """Run `hermes -p <profile> chat -Q -q "<content>" [--resume <session_id>]`。
+        返回 (answer, new_session_id)。-Q 让 stdout 只留最终回答，stderr 带 session_id。
+
+        健壮性（2026-09-27/28 事故系列）：
+        - 超时 kill 子进程——防 zombie 烧 token、断管道静默死亡、turn-lease 遗留堵死后续 resume
+        - resume 撞死进程 lease 时 hermes 秒回空 stdout（2s）；空输出且有 sid →
+          清 sid 重跑一次新会话自愈
+        - chat 300s 超时 → -z fresh oneshot 兜底一次（无历史包袱，绝大多数 <90s 出答案），
+          兜底仍失败才报超时
+        """
+        async def _chat_once(sid: Optional[str], timeout_s: float) -> "tuple[str, Optional[str]]":
+            cmd = [self._HERMES_BIN, "-p", profile, "chat", "-Q", "-q", content]
+            if sid:
+                cmd += ["--resume", sid]
+            proc = await asyncio.create_subprocess_exec(
+                *cmd,
+                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
+            )
+            try:
+                stdout, stderr = await asyncio.wait_for(proc.communicate(), timeout=timeout_s)
+            except asyncio.TimeoutError:
+                try:
+                    proc.kill()  # 防 zombie：等待也要回收，管道+lease 不能留给死进程
+                except Exception:  # noqa: BLE001
+                    pass
+                raise
+            answer = stdout.decode("utf-8", errors="replace").strip()
+            err = stderr.decode("utf-8", errors="replace")
+            m = re.search(r"session_id:\s*([0-9a-f_]+)", err)
+            new_sid = m.group(1) if m else sid
+            return (answer or ""), new_sid
+
+        try:
+            answer, new_sid = await _chat_once(session_id, 300)
+            if not answer and session_id:
+                # resume 空输出（典型=撞死进程 turn-lease 秒回）→
+                # ①先清该会话的「死进程遗留」lease 再用同 sid 重跑——保住上下文
+                #  （2026-10-03 学习会话断链 4 次复盘：超时 kill 后 lease 无法自清，
+                #   撞锁即弃 sid 的旧逻辑把可恢复的锁当成必须换会话）
+                # ②同 sid 重跑仍空（真锁竞争/会话损坏）才丢弃 sid 换新会话
+                cleared = await asyncio.to_thread(
+                    self._clear_dead_turn_leases, profile, session_id)
+                if cleared:
