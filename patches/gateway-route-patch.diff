+    async def _run_clean_script(self, targets: list, execute: bool) -> str:
+        """跑 clean_cache.py（预览或删除），返回其输出。"""
+        cmd = ["python3.14", self._CLEAN_SCRIPT]
+        if targets:
+            cmd += ["--targets", *targets]
+        if execute:
+            cmd.append("--execute")
+        env = dict(os.environ)
+        env["SOLOMON_VAULT"] = self._DELETE_VAULT
+        env["WORK_ROOT"] = self._WORK_ROOT
+        env.setdefault("PYTHONPATH",
+                       "/home/baner/.local/lib/python3.14/site-packages:/usr/lib/python3/dist-packages")
+        try:
+            proc = await asyncio.create_subprocess_exec(
+                *cmd, stdout=asyncio.subprocess.PIPE,
+                stderr=asyncio.subprocess.STDOUT, env=env,
+            )
+            out, _ = await asyncio.wait_for(proc.communicate(), timeout=900)
+            return out.decode("utf-8", errors="replace").strip()
+        except asyncio.TimeoutError:
+            return "⏱️ 清理脚本执行超时（>180s），未完成"
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("clean_cache failed: %s", exc)
+            return f"⚠️ 清理脚本执行失败：{exc}"
+
+    async def _hm_deterministic_confirm(
+        self, event: "MessageEvent", source: "SessionSource"
+    ) -> Optional[str]:
+        """确认类回复路由（确认清理缓存/确认删除）——**必须先于 profile_route 检查**：
+        有默认 profile 的渠道裸发确认会被 profile_route 当对话抢走（2026-10-04 实测：
+        飞书 @@solomon 默认下「确认清理缓存」被发给 solomon agent，confirm 分支永不到达）。
+        两类确认均后台执行 + 完成推送（drvfs 删除慢，同步静默会被当卡死发 /stop 误杀）。"""
+        text = _strip_feishu_mention((getattr(event, "text", None) or "").strip())
+        if not text or text.startswith("/"):
+            return None
+        target = self._source_target(source)
+
+        m = self._CLEAN_CONFIRM_RE.match(text)
+        if m:
+            targets = [t.strip() for t in re.split(r"[、，,；;\s]+", m.group(1)) if t.strip()]
+            # 纯标点目标（如「确认清理缓存！」的「！」）丢弃 → 视为全量确认，防怪回复
+            targets = [t for t in targets if re.search(r"[\w\u4e00-\u9fff]", t)]
+            label = "、".join(targets) if targets else "全部"
+            asyncio.create_task(self._run_clean_and_notify(targets, target))
+            return (
+                f"🧹 清理任务已启动（目标：{label}），正在后台删除。\n"
+                f"删除为跨系统盘操作，可能需要 1-5 分钟；完成后会把结果推送到本渠道。\n"
+                f"等待期间无需任何操作（此任务不受 /stop 影响）。"
+            )
+
+        m = self._DELETE_CONFIRM_RE.match(text)
+        if m:
+            targets = self._split_delete_targets(m.group(1).strip())
+            label = "、".join(targets)
+            asyncio.create_task(self._run_delete_and_notify(targets, target))
+            return (
+                f"🗑 删除任务已启动（{label}），正在后台执行。\n"
+                f"完成后会把结果推送到本渠道（此任务不受 /stop 影响）。"
+            )
+        return None
