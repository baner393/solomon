+        标题自身可能含空格（如「超级个体Vibe Coding创业」），不能按空格拆。
+        拆分顺序：
+          1. 顿号/逗号/分号/换行/「和」「与」分隔 → 每段独立
+          2. 若只有一段 → 用 vault 现有页面标题做「最长匹配」拆分
+             （如「A B C」三个标题连写空格分隔，逐个匹配已知标题）
+        """
+        parts = [p.strip() for p in re.split(r"[、，,；;\n]+", raw) if p.strip()]
+        if len(parts) > 1:
+            return parts
+        # 单段：尝试用 vault 已知标题拆分（最长优先，避免子串误切）
+        try:
+            known = sorted(_gateway_known_titles(), key=len, reverse=True)
+        except Exception:
+            known = []
+        found = []
+        rest = raw.strip()
+        for title in known:
+            if title and title in rest:
+                found.append(title)
+                rest = rest.replace(title, "", 1)
+        # 匹配到 ≥2 个已知标题即视为批量（剩余碎片忽略可能是已删/不存在页面）
+        if len(found) >= 2:
+            return found
+        return parts
