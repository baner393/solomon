# ═══════════════════════════════════════════════════════════════
# Solomon 系统环境变量模板（复制为各 profile 的 .env 并填入真实值）
# 用法：cp profiles/env.example ~/.hermes/profiles/<profile>/.env
# ═══════════════════════════════════════════════════════════════

# ── solomon 核心（三个 profile 都需要）──
# 知识库 vault（Obsidian 库根目录，会自动初始化 git）
SOLOMON_VAULT=/mnt/d/my_vault  # 或 ~/.solomon/vault
# 视频处理工作目录（下载/转写/关键帧中间产物）
WORK_ROOT=/mnt/d/video_work
# 临时学习区（--peek 产物；缺省 = WORK_ROOT 父目录/TempNotes）
# SOLOMON_TEMP=/mnt/d/TempNotes
# 文件定位搜索根（file_missing 自动定位用，冒号分隔）
SOLOMON_LOCATE_ROOTS=~:/mnt/d

# ── LLM 代理（SenseNova 4Key 轮换代理，见 scripts/sensenova-proxy/）──
# 3456=通用视觉/文本池 3458=flash-lite 文本池
# 代理脚本内配置 key；这里只指向端点
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890

# ── 渠道接入（按需启用，凭据自行申请）──
# QQ 官方机器人（https://q.qq.com 开放平台）
# QQ_APP_ID=你的appid
# QQ_CLIENT_SECRET=你的secret
# QQ_ALLOW_ALL_USERS=true
# QQBOT_HOME_CHANNEL=你的QQ号

# 飞书自建应用（https://open.feishu.cn）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_ALLOW_ALL_USERS=true
# FEISHU_HOME_CHANNEL=oc_xxx

# 微信（iLink 渠道，凭据见 hermes 文档）
# XIAOMI_API_KEY=xxx

# ── 可选：API server（程序化调用 coordinator）──
# API_SERVER_KEY=随机长字符串
